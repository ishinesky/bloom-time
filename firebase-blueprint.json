{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account details",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Information about a client or company",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "userId"]
    },
    "Project": {
      "title": "Project",
      "description": "A project belonging to a client",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "clientId": { "type": "string" },
        "userId": { "type": "string" },
        "color": { "type": "string" },
        "billable": { "type": "boolean" },
        "hourlyRate": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "clientId", "userId"]
    },
    "TimeEntry": {
      "title": "Time Entry",
      "description": "A single time tracking record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "number", "description": "Duration in seconds" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string", "format": "date-time" },
        "isRunning": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "projectId", "date"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing record for a client",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "userId": { "type": "string" },
        "number": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "paid"] },
        "dueDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "userId", "number", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients managed by users"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Projects belonging to clients"
    },
    "/timeEntries/{entryId}": {
      "schema": "TimeEntry",
      "description": "Time tracking logs"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices generated by users"
    }
  }
}
