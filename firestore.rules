rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Validation Helpers
    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
             data.userId == request.auth.uid;
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 &&
             data.clientId is string &&
             data.userId == request.auth.uid;
    }

    function isValidTimeEntry(data) {
      return data.userId == request.auth.uid &&
             data.projectId is string &&
             data.date is string &&
             data.duration is number;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && incoming().email is string;
    }

    match /clients/{clientId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidClient(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidClient(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidProject(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /timeEntries/{entryId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTimeEntry(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidTimeEntry(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /invoices/{invoiceId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
